                         "express-rate-limit":  "^8.7.1",
                         "express-validator":  "^7.3.2",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.3",
                         "prisma":  "^5.22.0",
                         "tsx":  "^4.23.15"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
