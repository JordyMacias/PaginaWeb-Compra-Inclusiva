// =====================================================
// ESQUEMA DE BASE DE DATOS — PRISMA + POSTGRESQL
// CompraInclusiva — Tienda de e-commerce inclusiva
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// USUARIOS Y AUTENTICACIÓN
// =====================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("customer")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relaciones
  addresses Address[]
  orders    Order[]

  @@index([email])
  @@map("users")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  recipientName String
  street        String
  apartment     String?
  city          String
  state         String
  country       String
  zipCode       String
  phone         String?
  isDefault     Boolean @default(false)
  createdAt     DateTime @default(now())

  // Relaciones
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// =====================================================
// CATÁLOGO DE PRODUCTOS
// =====================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  createdAt   DateTime @default(now())

  // Relaciones
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  shortDescription String?
  price            Float
  compareAtPrice   Float?
  stock            Int      @default(0)
  sku              String?  @unique
  categoryId       String
  tags             String[]
  featured         Boolean  @default(false)
  rating           Float?
  reviewCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String   // Texto alternativo — OBLIGATORIO para accesibilidad
  isPrimary Boolean  @default(false)
  order     Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String @id @default(cuid())
  productId       String
  name            String  // ej: "Talla", "Color"
  value           String  // ej: "L", "Azul"
  priceAdjustment Float  @default(0)
  stock           Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// =====================================================
// PEDIDOS
// =====================================================

model Order {
  id               String   @id @default(cuid())
  orderNumber      String   @unique
  userId           String
  status           String   @default("pending")
  paymentStatus    String   @default("pending")
  subtotal         Float
  tax              Float
  shipping         Float
  total            Float
  shippingAddressId String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  user            User       @relation(fields: [userId], references: [id])
  shippingAddress Address    @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  productName  String   // Denormalizado para histórico
  productImage String?
  variantId    String?
  variantLabel String?
  quantity     Int
  unitPrice    Float
  subtotal     Float

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
